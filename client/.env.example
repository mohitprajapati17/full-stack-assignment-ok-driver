# Base URL the browser uses for API calls. Keep "/api" in dev to use the Vite proxy.
VITE_API_BASE_URL=/api
# Where the Vite dev server proxies /api requests (dev only)
VITE_DEV_API_PROXY_TARGET=http://localhost:4000
# Optional map tile provider (defaults to OpenStreetMap, darkened with a CSS filter).
# OSM's public tiles are for light use; set a provider with an API key for production.
# VITE_MAP_TILE_URL=https://tiles.example.com/dark/{z}/{x}/{y}.png?api_key=...
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; Example
